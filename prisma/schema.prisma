generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 1. Model User (Data pengguna sistem UKS)
model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  password     String
  nama         String
  role         String    // ADMIN_UKS, PETUGAS_UKS, SISWA
  nisn         String?
  teleponOrtu  String?
  golonganDarah String?  // A, B, AB, O
  kelas        String?   // Contoh: X RPL 1, XI IPA 2
  jenisKelamin String?   // L / P
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relasi
  studentRecords MedicalRecord[] @relation("StudentRecords")
  petugasRecords MedicalRecord[] @relation("PetugasRecords")
  healthProfile  HealthProfile?
}

// 2. Model Medicine (Inventaris obat-obatan P3K)
model Medicine {
  id            Int                    @id @default(autoincrement())
  namaObat      String
  kategori      String                 // TABLET, SIRUP, SALEP, ALAT
  stok          Int                    @default(0)
  satuan        String                 // tablet, botol, tube, strip, pcs, roll
  tglKadaluarsa DateTime
  aturanPakai   String
  minStok       Int                    @default(10) // Ambang batas stok kritis
  lokasiRak     String?                // e.g. Rak A1, Kotak P3K 1
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  // Relasi
  prescriptions MedicinePrescription[]
}

// 3. Model MedicalRecord (Catatan kunjungan pemeriksaan siswa)
model MedicalRecord {
  id              Int                    @id @default(autoincrement())
  studentId       Int
  petugasId       Int
  tglKunjungan    DateTime               @default(now())
  jamMasuk        String                 // Contoh: "08:30"
  jamKeluar       String?                // Contoh: "09:45"
  keluhan         String
  suhuTubuh       Float                  // Contoh: 38.5
  tensi           String?                // Contoh: "120/80"
  tindakan        String
  status          String                 // DIRAWAT, KEMBALI_KELAS, PULANG, DIRUJUK
  noSurat         String?                // Nomor surat izin/rujukan otomatis
  keteranganSurat String?                // Alasan izin pulang / catatan untuk ortu/faskes
  faskesRujukan   String?                // Puskesmas/RS rujukan jika status DIRUJUK
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  // Relasi
  student       User                   @relation("StudentRecords", fields: [studentId], references: [id], onDelete: Cascade)
  petugas       User                   @relation("PetugasRecords", fields: [petugasId], references: [id], onDelete: Restrict)
  prescriptions MedicinePrescription[]
}

// 4. Model MedicinePrescription (Rincian obat yang diberikan)
model MedicinePrescription {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int
  medicineId      Int
  jumlah          Int
  dosis           String        // Contoh: "1 tablet sesudah makan"
  createdAt       DateTime      @default(now())

  // Relasi
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  medicine        Medicine      @relation(fields: [medicineId], references: [id], onDelete: Restrict)
}

// 5. Model HealthProfile (Profil kesehatan khusus siswa)
model HealthProfile {
  id              Int      @id @default(autoincrement())
  studentId       Int      @unique
  riwayatPenyakit String?  // Contoh: Asma, Gastritis/Maag
  alergiObat      String?  // Contoh: Paracetamol, Penisilin, Amoxicillin
  alergiMakanan   String?  // Contoh: Seafood, Kacang
  kontakDarurat   String?  // Nama & Nomor HP orang tua/wali
  catatanKhusus   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relasi
  student         User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}
