<% if (flash) { %>
  <div class="mb-6 space-y-3">
    <% if (flash.success) { %>
      <div class="flex items-center justify-between p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl shadow-sm animate-fade-in" role="alert">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center text-emerald-600 flex-shrink-0">
            <i class="fa-solid fa-circle-check text-lg"></i>
          </div>
          <div>
            <h4 class="font-semibold text-sm text-emerald-900">Operasi Berhasil</h4>
            <p class="text-sm text-emerald-700"><%= flash.success %></p>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-emerald-500 hover:text-emerald-700 p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    <% } %>

    <% if (flash.error) { %>
      <div class="flex items-center justify-between p-4 bg-rose-50 border border-rose-200 text-rose-800 rounded-xl shadow-sm animate-fade-in" role="alert">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-full bg-rose-100 flex items-center justify-center text-rose-600 flex-shrink-0">
            <i class="fa-solid fa-triangle-exclamation text-lg"></i>
          </div>
          <div>
            <h4 class="font-semibold text-sm text-rose-900">Perhatian / Peringatan</h4>
            <p class="text-sm text-rose-700"><%= flash.error %></p>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-rose-500 hover:text-rose-700 p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    <% } %>

    <% if (flash.info) { %>
      <div class="flex items-center justify-between p-4 bg-sky-50 border border-sky-200 text-sky-800 rounded-xl shadow-sm animate-fade-in" role="alert">
        <div class="flex items-center space-x-3">
          <div class="w-8 h-8 rounded-full bg-sky-100 flex items-center justify-center text-sky-600 flex-shrink-0">
            <i class="fa-solid fa-circle-info text-lg"></i>
          </div>
          <div>
            <h4 class="font-semibold text-sm text-sky-900">Informasi</h4>
            <p class="text-sm text-sky-700"><%= flash.info %></p>
          </div>
        </div>
        <button type="button" onclick="this.parentElement.remove()" class="text-sky-500 hover:text-sky-700 p-1">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
    <% } %>
  </div>
<% } %>
