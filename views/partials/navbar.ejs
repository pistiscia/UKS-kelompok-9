<header id="top-navbar" class="h-16 bg-white border-b border-slate-200 flex items-center justify-between px-6 sticky top-0 z-30 no-print">
  <!-- Left Side: Page Context & Live Clock -->
  <div class="flex items-center space-x-4">
    <div class="flex items-center space-x-2 text-slate-500 text-sm">
      <i class="fa-regular fa-calendar-days text-brand-600"></i>
      <span id="live-date" class="font-medium"></span>
      <span class="text-slate-300">•</span>
      <span id="live-clock" class="font-bold text-slate-700 bg-slate-100 px-2.5 py-0.5 rounded-lg font-mono text-xs"></span>
    </div>
  </div>

  <!-- Right Side: Status, Shortcuts, and Profile Menu -->
  <div class="flex items-center space-x-4">
    <% if (user && user.role === 'ADMIN_UKS') { %>
      <a href="/admin/medicines" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition-colors">
        <i class="fa-solid fa-plus"></i>
        <span>Kelola Obat</span>
      </a>
    <% } else if (user && user.role === 'PETUGAS_UKS') { %>
      <a href="/petugas/kunjungan/baru" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-brand-600 text-white hover:bg-brand-700 shadow-sm shadow-brand-600/30 transition-colors">
        <i class="fa-solid fa-stethoscope"></i>
        <span>Registrasi Kunjungan Baru</span>
      </a>
    <% } else if (user && user.role === 'SISWA') { %>
      <a href="/siswa/profil-kesehatan" class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-semibold bg-blue-50 text-blue-700 hover:bg-blue-100 border border-blue-200 transition-colors">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Perbarui Alergi Saya</span>
      </a>
    <% } %>

    <!-- User Pill -->
    <div class="flex items-center space-x-3 pl-3 border-l border-slate-200">
      <div class="text-right hidden sm:block">
        <p class="text-xs font-bold text-slate-800 leading-tight"><%= user ? user.nama : 'Tamu' %></p>
        <p class="text-[10px] text-slate-500 font-medium">
          <%= user ? (user.role === 'ADMIN_UKS' ? 'Administrator UKS' : user.role === 'PETUGAS_UKS' ? 'Tim Medis / PMR' : 'Siswa Sekolah') : '' %>
        </p>
      </div>
      <a href="/auth/logout" title="Keluar Akun" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-rose-50 hover:text-rose-600 flex items-center justify-center text-slate-500 text-xs transition-colors">
        <i class="fa-solid fa-power-off"></i>
      </a>
    </div>
  </div>
</header>

<script>
  function updateLiveClock() {
    const now = new Date();
    const optionsDate = { weekday: 'long', day: 'numeric', month: 'short', year: 'numeric' };
    const dateEl = document.getElementById('live-date');
    const clockEl = document.getElementById('live-clock');
    if (dateEl) dateEl.innerText = now.toLocaleDateString('id-ID', optionsDate);
    if (clockEl) {
      const h = String(now.getHours()).padStart(2, '0');
      const m = String(now.getMinutes()).padStart(2, '0');
      const s = String(now.getSeconds()).padStart(2, '0');
      clockEl.innerText = `${h}:${m}:${s} WIB`;
    }
  }
  updateLiveClock();
  setInterval(updateLiveClock, 1000);
</script>
