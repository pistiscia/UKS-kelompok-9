<aside class="sidebar w-64 bg-white border-r border-slate-200 flex flex-col flex-shrink-0 min-h-screen no-print select-none">
  <!-- Brand / Logo -->
  <div class="h-16 flex items-center px-6 border-b border-slate-100 bg-white">
    <a href="/" class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-teal-400 flex items-center justify-center text-white shadow-md shadow-brand-500/20">
        <i class="fa-solid fa-hospital-user text-xl"></i>
      </div>
      <div>
        <span class="text-lg font-bold tracking-tight text-slate-800">E-UKS</span>
        <span class="block text-[10px] font-semibold tracking-wider uppercase text-brand-600">Sistem Rekam Medis</span>
      </div>
    </a>
  </div>

  <!-- User Profile Widget in Sidebar -->
  <div class="p-4 mx-3 my-3 bg-gradient-to-r from-slate-50 to-emerald-50/50 rounded-2xl border border-slate-200/80">
    <div class="flex items-center space-x-3">
      <div class="w-10 h-10 rounded-xl bg-brand-500 text-white flex items-center justify-center font-bold text-sm shadow-sm">
        <% if (user && user.role === 'ADMIN_UKS') { %>
          <i class="fa-solid fa-user-shield"></i>
        <% } else if (user && user.role === 'PETUGAS_UKS') { %>
          <i class="fa-solid fa-user-doctor"></i>
        <% } else { %>
          <i class="fa-solid fa-user-graduate"></i>
        <% } %>
      </div>
      <div class="flex-1 min-w-0">
        <h3 class="text-sm font-semibold text-slate-800 truncate"><%= user ? user.nama : 'Pengguna' %></h3>
        <div class="flex items-center mt-0.5 space-x-1">
          <% if (user && user.role === 'ADMIN_UKS') { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-purple-100 text-purple-700">
              <i class="fa-solid fa-crown mr-1 text-[8px]"></i> ADMIN UKS
            </span>
          <% } else if (user && user.role === 'PETUGAS_UKS') { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-teal-100 text-teal-700">
              <i class="fa-solid fa-heart-pulse mr-1 text-[8px]"></i> PETUGAS UKS
            </span>
          <% } else { %>
            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-100 text-blue-700">
              <i class="fa-solid fa-graduation-cap mr-1 text-[8px]"></i> SISWA
            </span>
          <% } %>
        </div>
      </div>
    </div>
    <% if (user && user.kelas) { %>
      <div class="mt-2 pt-2 border-t border-slate-200/60 flex items-center justify-between text-[11px] text-slate-500">
        <span>Unit/Kelas:</span>
        <span class="font-medium text-slate-700"><%= user.kelas %></span>
      </div>
    <% } %>
  </div>

  <!-- Navigation Links -->
  <nav class="flex-1 px-3 space-y-1 overflow-y-auto">
    <% if (user && user.role === 'ADMIN_UKS') { %>
      <div class="px-3 pt-2 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">Menu Pembina UKS</div>
      
      <a href="/admin/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/admin/dashboard' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-chart-pie w-5 text-center text-base <%= currentPath === '/admin/dashboard' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Dashboard Analitik</span>
      </a>

      <a href="/admin/medicines" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath.startsWith('/admin/medicines') ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-pills w-5 text-center text-base <%= currentPath.startsWith('/admin/medicines') ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Master Obat & P3K</span>
      </a>

      <a href="/admin/monitoring" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/admin/monitoring' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-triangle-exclamation w-5 text-center text-base <%= currentPath === '/admin/monitoring' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Monitoring Kadaluarsa</span>
      </a>

      <a href="/admin/students" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/admin/students' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-address-book w-5 text-center text-base <%= currentPath === '/admin/students' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Data Siswa & Alergi</span>
      </a>

      <div class="px-3 pt-4 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">Supervisi Pelayanan</div>

      <a href="/petugas/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100 hover:text-slate-900">
        <i class="fa-solid fa-stethoscope w-5 text-center text-base text-slate-400"></i>
        <span>Ruang Pemeriksaan</span>
      </a>

      <a href="/petugas/laporan-bulanan" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors text-slate-600 hover:bg-slate-100 hover:text-slate-900">
        <i class="fa-solid fa-file-invoice w-5 text-center text-base text-slate-400"></i>
        <span>Rekap Laporan Bulanan</span>
      </a>

    <% } else if (user && user.role === 'PETUGAS_UKS') { %>
      <div class="px-3 pt-2 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">Menu Petugas UKS</div>

      <a href="/petugas/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/petugas/dashboard' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-notes-medical w-5 text-center text-base <%= currentPath === '/petugas/dashboard' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Dashboard Pelayanan</span>
      </a>

      <a href="/petugas/kunjungan/baru" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/petugas/kunjungan/baru' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-user-plus w-5 text-center text-base <%= currentPath === '/petugas/kunjungan/baru' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Registrasi Kunjungan</span>
      </a>

      <a href="/petugas/laporan-bulanan" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/petugas/laporan-bulanan' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-print w-5 text-center text-base <%= currentPath === '/petugas/laporan-bulanan' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Laporan Rekapitulasi</span>
      </a>

    <% } else if (user && user.role === 'SISWA') { %>
      <div class="px-3 pt-2 pb-1 text-[11px] font-bold uppercase tracking-wider text-slate-400">Portal Siswa</div>

      <a href="/siswa/dashboard" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/siswa/dashboard' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-id-card-clip w-5 text-center text-base <%= currentPath === '/siswa/dashboard' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Status Izin Digital</span>
      </a>

      <a href="/siswa/riwayat" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/siswa/riwayat' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-clock-rotate-left w-5 text-center text-base <%= currentPath === '/siswa/riwayat' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Riwayat Rekam Medis</span>
      </a>

      <a href="/siswa/profil-kesehatan" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/siswa/profil-kesehatan' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-shield-virus w-5 text-center text-base <%= currentPath === '/siswa/profil-kesehatan' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Riwayat Alergi & Penyakit</span>
      </a>

      <a href="/siswa/katalog-obat" class="flex items-center space-x-3 px-3 py-2.5 rounded-xl text-sm font-medium transition-colors <%= currentPath === '/siswa/katalog-obat' ? 'bg-brand-50 text-brand-700 font-semibold border-l-4 border-brand-600' : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900' %>">
        <i class="fa-solid fa-kit-medical w-5 text-center text-base <%= currentPath === '/siswa/katalog-obat' ? 'text-brand-600' : 'text-slate-400' %>"></i>
        <span>Ketersediaan Obat P3K</span>
      </a>
    <% } %>
  </nav>

  <!-- Switch Role Demo Quick Bar in Sidebar -->
  <div class="p-3 border-t border-slate-200 bg-slate-50">
    <div class="text-[10px] font-bold uppercase tracking-wider text-slate-500 mb-2 flex items-center justify-between">
      <span>Ganti Role Demo (Penguji):</span>
      <i class="fa-solid fa-arrows-rotate text-slate-400"></i>
    </div>
    <div class="grid grid-cols-3 gap-1">
      <a href="/auth/quick-login?role=admin" title="Login sebagai Admin UKS" class="py-1 px-1.5 rounded-lg text-center text-[10px] font-bold <%= user && user.role === 'ADMIN_UKS' ? 'bg-purple-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100' %>">
        Admin
      </a>
      <a href="/auth/quick-login?role=petugas" title="Login sebagai Petugas UKS" class="py-1 px-1.5 rounded-lg text-center text-[10px] font-bold <%= user && user.role === 'PETUGAS_UKS' ? 'bg-teal-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100' %>">
        Petugas
      </a>
      <a href="/auth/quick-login?role=siswa" title="Login sebagai Siswa" class="py-1 px-1.5 rounded-lg text-center text-[10px] font-bold <%= user && user.role === 'SISWA' ? 'bg-blue-600 text-white' : 'bg-white text-slate-700 border border-slate-200 hover:bg-slate-100' %>">
        Siswa
      </a>
    </div>

    <!-- Logout -->
    <a href="/auth/logout" class="mt-3 flex items-center justify-center space-x-2 w-full py-2 px-3 text-xs font-semibold text-rose-600 bg-rose-50 hover:bg-rose-100 rounded-xl transition-colors">
      <i class="fa-solid fa-arrow-right-from-bracket"></i>
      <span>Keluar Sistem</span>
    </a>
  </div>
</aside>
