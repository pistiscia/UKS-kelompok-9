<%- include('../partials/header') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/navbar') %>

    <main class="flex-1 p-6 md:p-8 space-y-6 max-w-4xl w-full mx-auto">
      
      <!-- Top Action Bar -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <span class="inline-flex items-center space-x-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800">
            <i class="fa-solid fa-shield-virus text-[10px]"></i>
            <span>Keselamatan Pasien Siswa</span>
          </span>
          <h1 class="text-2xl font-extrabold text-slate-900 mt-2">
            Riwayat Alergi & Penyakit Bawaan
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Lengkapi data riwayat alergi obat dan penyakit bawaan untuk mencegah komplikasi dan kesalahan penanganan medis saat darurat.
          </p>
        </div>

        <a href="/siswa/dashboard" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-sm self-start sm:self-auto">
          <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Dashboard
        </a>
      </div>

      <%- include('../partials/alerts') %>

      <!-- Alert Card Pedoman -->
      <div class="p-4 bg-gradient-to-r from-blue-50 to-indigo-50 border border-blue-200 rounded-2xl flex items-start space-x-3.5 text-xs text-blue-900">
        <div class="w-8 h-8 rounded-xl bg-blue-500 text-white flex items-center justify-center font-bold text-sm flex-shrink-0 mt-0.5">
          <i class="fa-solid fa-info"></i>
        </div>
        <div>
          <h4 class="font-bold text-blue-950">Mengapa Informasi Ini Sangat Krusial?</h4>
          <p class="mt-0.5 text-blue-800">
            Ketika Anda pingsan atau mengalami demam tinggi mendadak, Petugas UKS akan segera membaca catatan ini untuk memastikan <strong>tidak ada obat yang bertentangan dengan alergi Anda</strong> (misal: alergi Penisilin, Aspirin, atau Paracetamol).
          </p>
        </div>
      </div>

      <!-- Form Pengisian Profil Kesehatan -->
      <div class="bg-white p-6 sm:p-8 rounded-3xl border border-slate-200/80 shadow-sm">
        <form action="/siswa/profil-kesehatan" method="POST" class="space-y-6">
          
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
            <!-- Golongan Darah -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase">Golongan Darah *</label>
              <select name="golonganDarah" class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:ring-2 focus:ring-blue-500 bg-slate-50">
                <option value="">-- Pilih Golongan Darah --</option>
                <option value="A" <%= student.golonganDarah === 'A' ? 'selected' : '' %>>Golongan Darah A</option>
                <option value="B" <%= student.golonganDarah === 'B' ? 'selected' : '' %>>Golongan Darah B</option>
                <option value="AB" <%= student.golonganDarah === 'AB' ? 'selected' : '' %>>Golongan Darah AB</option>
                <option value="O" <%= student.golonganDarah === 'O' ? 'selected' : '' %>>Golongan Darah O</option>
              </select>
            </div>

            <!-- Telepon Orang Tua -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase">Nomor HP Orang Tua / Wali *</label>
              <input
                type="text"
                name="teleponOrtu"
                value="<%= student.teleponOrtu || '' %>"
                required
                placeholder="Contoh: 081234567890"
                class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500"
              />
            </div>
          </div>

          <!-- Alergi Obat (FIELD SANGAT PENTING) -->
          <div class="p-4 rounded-2xl bg-rose-50/60 border border-rose-200">
            <div class="flex items-center space-x-2 text-rose-800 font-bold text-xs uppercase mb-1">
              <i class="fa-solid fa-triangle-exclamation"></i>
              <span>Riwayat Alergi Obat-Obatan (WAJIB DIPERHATIKAN)</span>
            </div>
            <textarea
              name="alergiObat"
              rows="2"
              placeholder="Sebutkan nama obat yang membuat Anda alergi, ruam, gatal, atau sesak nafas (Contoh: Penisilin, Amoxicillin, Aspirin, Ibuprofen, Paracetamol dosis tinggi). Tuliskan 'Tidak ada' jika tidak memiliki riwayat alergi."
              class="mt-1 w-full px-3.5 py-2.5 border border-rose-200 rounded-xl text-xs focus:ring-2 focus:ring-rose-500 bg-white font-medium text-slate-900"
            ><%= profile.alergiObat || '' %></textarea>
            <p class="text-[10px] text-rose-700 mt-1">Sistem akan memblokir/memperingatkan petugas UKS jika meresepkan obat tersebut.</p>
          </div>

          <!-- Alergi Makanan -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase">Riwayat Alergi Makanan</label>
            <input
              type="text"
              name="alergiMakanan"
              value="<%= profile.alergiMakanan || '' %>"
              placeholder="Contoh: Udang, Kepiting (Seafood), Kacang Tanah, Telur, dll."
              class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <!-- Riwayat Penyakit Bawaan -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase">Riwayat Penyakit Bawaan / Kronis</label>
            <textarea
              name="riwayatPenyakit"
              rows="2"
              placeholder="Contoh: Asma kronis, Gastritis / Maag Akut, Sinusitis, Jantung, Epilepsi, Vertigo, dll."
              class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500"
            ><%= profile.riwayatPenyakit || '' %></textarea>
          </div>

          <!-- Kontak Darurat Spesifik -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase">Kontak Darurat (Nama & Hubungan Keluarga)</label>
            <input
              type="text"
              name="kontakDarurat"
              value="<%= profile.kontakDarurat || '' %>"
              placeholder="Contoh: Bpk. Bambang Pratama (Ayah Kandung) - 081234567890"
              class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500"
            />
          </div>

          <!-- Catatan Khusus -->
          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase">Catatan Khusus Bagi Tenaga Medis UKS</label>
            <textarea
              name="catatanKhusus"
              rows="2"
              placeholder="Contoh: Membawa inhaler pribadi di tas, hindari aktivitas olahraga berat saat cuaca terik..."
              class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500"
            ><%= profile.catatanKhusus || '' %></textarea>
          </div>

          <div class="pt-4 border-t border-slate-100 flex justify-end">
            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs shadow-md shadow-blue-600/30 transition-all flex items-center justify-center space-x-2"
            >
              <i class="fa-solid fa-floppy-disk"></i>
              <span>Simpan Profil Kesehatan Saya</span>
            </button>
          </div>

        </form>
      </div>

    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
