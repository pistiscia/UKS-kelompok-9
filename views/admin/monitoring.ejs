<%- include('../partials/header') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/navbar') %>

    <main class="flex-1 p-6 md:p-8 space-y-6 max-w-7xl w-full mx-auto">
      
      <!-- Top Action & Title Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <span class="inline-flex items-center space-x-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-rose-100 text-rose-800">
            <i class="fa-solid fa-shield-halved text-[10px]"></i>
            <span>Logistik Medis & Keamanan Obat</span>
          </span>
          <h1 class="text-2xl font-extrabold text-slate-900 mt-2">
            Monitoring Kadaluarsa & Ambang Batas Stok P3K
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Mencegah pemberian obat kedaluwarsa kepada siswa dan mengantisipasi kekosongan obat darurat UKS.
          </p>
        </div>

        <a href="/admin/medicines" class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-sm transition-all self-start sm:self-auto">
          <i class="fa-solid fa-plus-circle"></i>
          <span>Kelola Semua Obat</span>
        </a>
      </div>

      <%- include('../partials/alerts') %>

      <!-- 3 Status Alert Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <!-- Expired Card -->
        <div class="p-5 rounded-2xl bg-white border border-rose-200/80 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-rose-500">Sudah Kadaluarsa</span>
            <h3 class="text-3xl font-extrabold text-rose-600 mt-1"><%= expiredList.length %></h3>
            <p class="text-xs text-slate-500 mt-0.5">Wajib segera disingkirkan dari rak</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-ban"></i>
          </div>
        </div>

        <!-- Near Expiry Card -->
        <div class="p-5 rounded-2xl bg-white border border-amber-200/80 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-amber-500">Kadaluarsa < 60 Hari</span>
            <h3 class="text-3xl font-extrabold text-amber-600 mt-1"><%= nearExpiryList.length %></h3>
            <p class="text-xs text-slate-500 mt-0.5">Mendekati masa habis pakai</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-hourglass-half"></i>
          </div>
        </div>

        <!-- Low Stock Card -->
        <div class="p-5 rounded-2xl bg-white border border-slate-200/80 shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-orange-500">Stok Di Bawah Ambang Min</span>
            <h3 class="text-3xl font-extrabold text-orange-600 mt-1"><%= lowStockList.length %></h3>
            <p class="text-xs text-slate-500 mt-0.5">Perlu pengajuan pengadaan/restock</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-orange-50 text-orange-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-boxes-stacked"></i>
          </div>
        </div>
      </div>

      <!-- Section 1: Daftar Obat Kadaluarsa & Mendekati Kadaluarsa -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-5 bg-rose-50/40 border-b border-rose-100 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-lg bg-rose-500 text-white flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-calendar-xmark"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-800">1. Daftar Obat Kadaluarsa & Mendekati Habis Masa Pakai</h3>
              <p class="text-xs text-slate-500">Audit masa simpan sediaan farmasi UKS</p>
            </div>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
              <tr>
                <th class="px-5 py-3">Nama Obat</th>
                <th class="px-5 py-3">Kategori</th>
                <th class="px-5 py-3">Stok Saat Ini</th>
                <th class="px-5 py-3">Tanggal Kadaluarsa</th>
                <th class="px-5 py-3">Lokasi Simpan</th>
                <th class="px-5 py-3 text-center">Status Keamanan</th>
                <th class="px-5 py-3 text-right">Tindakan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% const expCombined = [...expiredList, ...nearExpiryList]; %>
              <% if (expCombined.length > 0) { %>
                <% expCombined.forEach(med => { %>
                  <% 
                    const isPassed = new Date(med.tglKadaluarsa) < now;
                    const diffDays = Math.ceil((new Date(med.tglKadaluarsa) - now) / (1000 * 60 * 60 * 24));
                  %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-5 py-3.5 font-bold text-slate-900"><%= med.namaObat %></td>
                    <td class="px-5 py-3.5 text-slate-600"><%= med.kategori %></td>
                    <td class="px-5 py-3.5 font-semibold text-slate-700"><%= med.stok %> <%= med.satuan %></td>
                    <td class="px-5 py-3.5 whitespace-nowrap">
                      <div class="font-bold <%= isPassed ? 'text-rose-600' : 'text-amber-600' %>">
                        <%= new Date(med.tglKadaluarsa).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %>
                      </div>
                      <div class="text-[10px] text-slate-500">
                        <%= isPassed ? `Sudah lewat ${Math.abs(diffDays)} hari yang lalu` : `Sisa ${diffDays} hari lagi` %>
                      </div>
                    </td>
                    <td class="px-5 py-3.5 text-slate-500"><%= med.lokasiRak || 'Lemari UKS' %></td>
                    <td class="px-5 py-3.5 text-center">
                      <% if (isPassed) { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                          <i class="fa-solid fa-skull-crossbones mr-1"></i> EXPIRED
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                          <i class="fa-solid fa-clock-rotate-left mr-1"></i> Mendekati Expired
                        </span>
                      <% } %>
                    </td>
                    <td class="px-5 py-3.5 text-right whitespace-nowrap">
                      <a href="/admin/medicines" class="px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition-colors">
                        Perbarui Batch
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-5 py-8 text-center text-slate-400">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-2xl mb-1"></i>
                    <p class="font-medium">Tidak ada obat yang kadaluarsa atau mendekati masa kadaluarsa.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section 2: Daftar Obat Di Bawah Ambang Batas Stok Minimal -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-5 bg-amber-50/40 border-b border-amber-100 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center text-sm font-bold">
              <i class="fa-solid fa-boxes-packing"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-800">2. Obat di Bawah Ambang Batas Stok (Low Stock Alert)</h3>
              <p class="text-xs text-slate-500">Perlu pengadaan ulang agar persediaan pertolongan pertama tidak habis</p>
            </div>
          </div>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
              <tr>
                <th class="px-5 py-3">Nama Obat</th>
                <th class="px-5 py-3">Kategori</th>
                <th class="px-5 py-3">Stok Saat Ini</th>
                <th class="px-5 py-3">Ambang Batas Min</th>
                <th class="px-5 py-3">Defisit Stok</th>
                <th class="px-5 py-3">Lokasi Simpan</th>
                <th class="px-5 py-3 text-right">Aksi Cepat</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (lowStockList.length > 0) { %>
                <% lowStockList.forEach(med => { %>
                  <% const defisit = Math.max(0, med.minStok - med.stok); %>
                  <tr class="hover:bg-slate-50 transition-colors">
                    <td class="px-5 py-3.5 font-bold text-slate-900"><%= med.namaObat %></td>
                    <td class="px-5 py-3.5 text-slate-600"><%= med.kategori %></td>
                    <td class="px-5 py-3.5 font-extrabold text-rose-600 text-sm">
                      <%= med.stok %> <%= med.satuan %>
                    </td>
                    <td class="px-5 py-3.5 text-slate-600 font-semibold"><%= med.minStok %> <%= med.satuan %></td>
                    <td class="px-5 py-3.5">
                      <span class="px-2 py-0.5 rounded bg-rose-50 text-rose-700 font-bold text-[10px]">
                        -<%= defisit %> <%= med.satuan %>
                      </span>
                    </td>
                    <td class="px-5 py-3.5 text-slate-500"><%= med.lokasiRak || 'Lemari UKS' %></td>
                    <td class="px-5 py-3.5 text-right whitespace-nowrap">
                      <a href="/admin/medicines" class="px-3 py-1.5 rounded-lg bg-teal-50 hover:bg-teal-100 text-teal-700 font-semibold text-[11px] transition-colors">
                        <i class="fa-solid fa-plus-circle mr-1"></i> Restock
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-5 py-8 text-center text-slate-400">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-2xl mb-1"></i>
                    <p class="font-medium">Seluruh persediaan obat berada di atas ambang batas minimal stok aman!</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
