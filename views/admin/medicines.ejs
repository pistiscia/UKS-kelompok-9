<%- include('../partials/header') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/navbar') %>

    <main class="flex-1 p-6 md:p-8 space-y-6 max-w-7xl w-full mx-auto">
      
      <!-- Top Action & Title Header -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-extrabold text-slate-900">Master Inventaris Obat & P3K</h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Kelola master data obat, ambang batas stok aman, dan tanggal kadaluarsa perlengkapan medis.
          </p>
        </div>

        <button
          type="button"
          onclick="openAddModal()"
          class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-sm shadow-brand-600/30 transition-all self-start sm:self-auto"
        >
          <i class="fa-solid fa-plus-circle"></i>
          <span>Tambah Obat Baru</span>
        </button>
      </div>

      <%- include('../partials/alerts') %>

      <!-- Filter & Search Toolbar -->
      <div class="bg-white p-4 rounded-2xl border border-slate-200/80 shadow-sm flex flex-col md:flex-row gap-4 justify-between items-center">
        <!-- Search Input -->
        <form action="/admin/medicines" method="GET" class="w-full md:w-auto flex-1 flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
              <i class="fa-solid fa-magnifying-glass text-xs"></i>
            </span>
            <input
              type="text"
              name="search"
              value="<%= search %>"
              placeholder="Cari nama obat, aturan pakai, atau rak..."
              class="w-full pl-9 pr-4 py-2 rounded-xl border border-slate-200 text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none"
            />
          </div>

          <!-- Kategori Filter -->
          <select
            name="kategori"
            onchange="this.form.submit()"
            class="py-2 px-3 rounded-xl border border-slate-200 text-xs text-slate-700 focus:ring-2 focus:ring-brand-500 focus:outline-none"
          >
            <option value="SEMUA" <%= kategori === 'SEMUA' ? 'selected' : '' %>>Semua Kategori</option>
            <option value="TABLET" <%= kategori === 'TABLET' ? 'selected' : '' %>>TABLET</option>
            <option value="SIRUP" <%= kategori === 'SIRUP' ? 'selected' : '' %>>SIRUP</option>
            <option value="SALEP" <%= kategori === 'SALEP' ? 'selected' : '' %>>SALEP</option>
            <option value="ALAT" <%= kategori === 'ALAT' ? 'selected' : '' %>>ALAT P3K</option>
          </select>

          <!-- Status Filter -->
          <select
            name="statusFilter"
            onchange="this.form.submit()"
            class="py-2 px-3 rounded-xl border border-slate-200 text-xs text-slate-700 focus:ring-2 focus:ring-brand-500 focus:outline-none"
          >
            <option value="SEMUA" <%= statusFilter === 'SEMUA' ? 'selected' : '' %>>Semua Status Stok</option>
            <option value="LOW_STOCK" <%= statusFilter === 'LOW_STOCK' ? 'selected' : '' %>>⚠️ Stok Kritis (<= Min)</option>
            <option value="EXPIRING_SOON" <%= statusFilter === 'EXPIRING_SOON' ? 'selected' : '' %>>⏳ Expired < 30 Hari</option>
            <option value="EXPIRED" <%= statusFilter === 'EXPIRED' ? 'selected' : '' %>>🚫 Sudah Kadaluarsa</option>
          </select>

          <button
            type="submit"
            class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold rounded-xl text-xs transition-colors"
          >
            Cari
          </button>
          <% if (search || kategori !== 'SEMUA' || statusFilter !== 'SEMUA') { %>
            <a href="/admin/medicines" class="px-3 py-2 text-rose-600 hover:underline text-xs flex items-center justify-center">
              Reset
            </a>
          <% } %>
        </form>

        <div class="text-xs text-slate-500 whitespace-nowrap self-end md:self-center">
          Total: <strong class="text-slate-800"><%= medicines.length %></strong> item obat
        </div>
      </div>

      <!-- Medicines Table Card -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
              <tr>
                <th class="px-5 py-3.5">Nama Obat & Lokasi</th>
                <th class="px-5 py-3.5">Kategori</th>
                <th class="px-5 py-3.5">Stok Tersedia</th>
                <th class="px-5 py-3.5">Tgl Kadaluarsa</th>
                <th class="px-5 py-3.5">Aturan Pakai</th>
                <th class="px-5 py-3.5 text-center">Status</th>
                <th class="px-5 py-3.5 text-right">Aksi</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (medicines && medicines.length > 0) { %>
                <% medicines.forEach(med => { %>
                  <% 
                    const isExpired = new Date(med.tglKadaluarsa) < now;
                    const isExpiringSoon = !isExpired && new Date(med.tglKadaluarsa) <= thirtyDaysLater;
                    const isLowStock = med.stok <= med.minStok;
                  %>
                  <tr class="hover:bg-slate-50/70 transition-colors">
                    <!-- Nama & Rak -->
                    <td class="px-5 py-4">
                      <div class="font-bold text-slate-900 text-sm"><%= med.namaObat %></div>
                      <div class="text-[11px] text-slate-500 mt-0.5 flex items-center space-x-1">
                        <i class="fa-solid fa-boxes-packing text-slate-400"></i>
                        <span><%= med.lokasiRak || 'Lemari UKS' %></span>
                      </div>
                    </td>

                    <!-- Kategori -->
                    <td class="px-5 py-4">
                      <% if (med.kategori === 'TABLET') { %>
                        <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-200">TABLET</span>
                      <% } else if (med.kategori === 'SIRUP') { %>
                        <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">SIRUP</span>
                      <% } else if (med.kategori === 'SALEP') { %>
                        <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">SALEP</span>
                      <% } else { %>
                        <span class="px-2.5 py-1 rounded-md text-[10px] font-bold bg-purple-50 text-purple-700 border border-purple-200">ALAT P3K</span>
                      <% } %>
                    </td>

                    <!-- Stok -->
                    <td class="px-5 py-4">
                      <div class="font-extrabold text-sm <%= isLowStock ? 'text-rose-600' : 'text-slate-800' %>">
                        <%= med.stok %> <span class="text-xs font-normal text-slate-500"><%= med.satuan %></span>
                      </div>
                      <div class="text-[10px] text-slate-400 mt-0.5">Min: <%= med.minStok %> <%= med.satuan %></div>
                    </td>

                    <!-- Kadaluarsa -->
                    <td class="px-5 py-4 whitespace-nowrap">
                      <div class="font-medium <%= isExpired ? 'text-rose-600 font-bold' : (isExpiringSoon ? 'text-amber-600 font-semibold' : 'text-slate-700') %>">
                        <%= new Date(med.tglKadaluarsa).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </div>
                      <% if (isExpired) { %>
                        <div class="text-[10px] font-bold text-rose-600 uppercase">Sudah Kadaluarsa!</div>
                      <% } else if (isExpiringSoon) { %>
                        <div class="text-[10px] font-semibold text-amber-600">Segera Kadaluarsa</div>
                      <% } %>
                    </td>

                    <!-- Aturan Pakai -->
                    <td class="px-5 py-4 text-slate-600 max-w-xs">
                      <div class="line-clamp-2 text-xs"><%= med.aturanPakai || '-' %></div>
                    </td>

                    <!-- Status Indikator -->
                    <td class="px-5 py-4 text-center whitespace-nowrap">
                      <% if (isExpired) { %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                          <i class="fa-solid fa-ban mr-1"></i> Kadaluarsa
                        </span>
                      <% } else if (isLowStock) { %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                          <i class="fa-solid fa-triangle-exclamation mr-1"></i> Stok Kritis
                        </span>
                      <% } else { %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          <i class="fa-solid fa-check mr-1"></i> Aman
                        </span>
                      <% } %>
                    </td>

                    <!-- Action Buttons -->
                    <td class="px-5 py-4 text-right whitespace-nowrap space-x-1.5">
                      <!-- Tombol Restock -->
                      <button
                        type="button"
                        onclick="openRestockModal(<%= JSON.stringify(med) %>)"
                        title="Tambah Stok (Restock)"
                        class="p-2 rounded-lg bg-teal-50 text-teal-600 hover:bg-teal-100 transition-colors"
                      >
                        <i class="fa-solid fa-boxes-packing"></i>
                      </button>

                      <!-- Tombol Edit -->
                      <button
                        type="button"
                        onclick="openEditModal(<%= JSON.stringify(med) %>)"
                        title="Edit Data Obat"
                        class="p-2 rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition-colors"
                      >
                        <i class="fa-solid fa-pen-to-square"></i>
                      </button>

                      <!-- Tombol Hapus -->
                      <form
                        action="/admin/medicines/<%= med.id %>/delete"
                        method="POST"
                        class="inline-block"
                        onsubmit="return confirm('Apakah Anda yakin ingin menghapus data obat <%= med.namaObat %>?');"
                      >
                        <button
                          type="submit"
                          title="Hapus Obat"
                          class="p-2 rounded-lg bg-rose-50 text-rose-600 hover:bg-rose-100 transition-colors"
                        >
                          <i class="fa-solid fa-trash-can"></i>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-5 py-12 text-center text-slate-400">
                    <i class="fa-solid fa-box-open text-4xl mb-2 text-slate-300"></i>
                    <p class="text-sm font-semibold">Tidak ada obat yang cocok dengan kriteria pencarian.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<!-- ================= MODAL TAMBAH OBAT ================= -->
<div id="addModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100 animate-scale-up">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-brand-100 text-brand-600 flex items-center justify-center">
          <i class="fa-solid fa-plus font-bold"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">Tambah Obat / Alat P3K Baru</h3>
      </div>
      <button onclick="closeAddModal()" class="text-slate-400 hover:text-slate-600 p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form action="/admin/medicines" method="POST" class="mt-4 space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase">Nama Obat / Alat Medis *</label>
        <input type="text" name="namaObat" required placeholder="Contoh: Paracetamol 500mg" class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Kategori *</label>
          <select name="kategori" required class="mt-1 w-full px-3 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none">
            <option value="TABLET">TABLET</option>
            <option value="SIRUP">SIRUP</option>
            <option value="SALEP">SALEP</option>
            <option value="ALAT">ALAT P3K</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Satuan *</label>
          <input type="text" name="satuan" required placeholder="tablet, botol, tube, pcs" class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Jumlah Stok Awal *</label>
          <input type="number" name="stok" min="0" value="100" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Ambang Batas Min Stok</label>
          <input type="number" name="minStok" min="1" value="15" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Tgl Kadaluarsa *</label>
          <input type="date" name="tglKadaluarsa" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Lokasi Rak / Kotak P3K</label>
          <input type="text" name="lokasiRak" placeholder="Rak A1, Bed 1, dll" class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase">Aturan Pakai & Dosis</label>
        <textarea name="aturanPakai" rows="2" placeholder="Contoh: 1 tablet 3x sehari sesudah makan" class="mt-1 w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-brand-500 focus:outline-none"></textarea>
      </div>

      <div class="pt-3 flex space-x-3">
        <button type="button" onclick="closeAddModal()" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold text-xs transition-colors">Batal</button>
        <button type="submit" class="flex-1 py-2.5 bg-brand-600 hover:bg-brand-700 text-white rounded-xl font-semibold text-xs shadow-md transition-colors">Simpan Obat</button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL RESTOCK OBAT ================= -->
<div id="restockModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-teal-100 text-teal-600 flex items-center justify-center">
          <i class="fa-solid fa-boxes-packing"></i>
        </div>
        <div>
          <h3 class="text-base font-bold text-slate-900">Restock / Tambah Stok Obat</h3>
          <p id="restock-med-name" class="text-xs text-brand-600 font-semibold"></p>
        </div>
      </div>
      <button onclick="closeRestockModal()" class="text-slate-400 hover:text-slate-600 p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="restockForm" method="POST" class="mt-4 space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase">Jumlah Tambahan Stok *</label>
        <div class="mt-1 relative rounded-xl shadow-sm">
          <input type="number" name="tambahStok" min="1" required placeholder="Contoh: 50 atau 100" class="w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none" />
          <span id="restock-satuan" class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-xs text-slate-400 font-medium"></span>
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase">Perbarui Tanggal Kadaluarsa (Jika Batch Baru)</label>
        <input type="date" name="tglKadaluarsaBaru" class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none" />
      </div>

      <div class="pt-3 flex space-x-3">
        <button type="button" onclick="closeRestockModal()" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold text-xs transition-colors">Batal</button>
        <button type="submit" class="flex-1 py-2.5 bg-teal-600 hover:bg-teal-700 text-white rounded-xl font-semibold text-xs shadow-md transition-colors">Konfirmasi Restock</button>
      </div>
    </form>
  </div>
</div>

<!-- ================= MODAL EDIT OBAT ================= -->
<div id="editModal" class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center p-4">
  <div class="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl border border-slate-100">
    <div class="flex items-center justify-between pb-4 border-b border-slate-100">
      <div class="flex items-center space-x-2.5">
        <div class="w-8 h-8 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center">
          <i class="fa-solid fa-pen-to-square"></i>
        </div>
        <h3 class="text-base font-bold text-slate-900">Perbarui Data Obat</h3>
      </div>
      <button onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 p-1">
        <i class="fa-solid fa-xmark text-lg"></i>
      </button>
    </div>

    <form id="editForm" method="POST" class="mt-4 space-y-4">
      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase">Nama Obat / Alat *</label>
        <input type="text" id="edit-nama" name="namaObat" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Kategori *</label>
          <select id="edit-kategori" name="kategori" required class="mt-1 w-full px-3 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <option value="TABLET">TABLET</option>
            <option value="SIRUP">SIRUP</option>
            <option value="SALEP">SALEP</option>
            <option value="ALAT">ALAT P3K</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Satuan *</label>
          <input type="text" id="edit-satuan" name="satuan" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Jumlah Stok *</label>
          <input type="number" id="edit-stok" name="stok" min="0" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Min Ambang Batas</label>
          <input type="number" id="edit-minStok" name="minStok" min="1" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Tgl Kadaluarsa *</label>
          <input type="date" id="edit-tglKadaluarsa" name="tglKadaluarsa" required class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase">Lokasi Rak</label>
          <input type="text" id="edit-lokasiRak" name="lokasiRak" class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none" />
        </div>
      </div>

      <div>
        <label class="block text-xs font-bold text-slate-700 uppercase">Aturan Pakai</label>
        <textarea id="edit-aturanPakai" name="aturanPakai" rows="2" class="mt-1 w-full px-3.5 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
      </div>

      <div class="pt-3 flex space-x-3">
        <button type="button" onclick="closeEditModal()" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-semibold text-xs transition-colors">Batal</button>
        <button type="submit" class="flex-1 py-2.5 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-semibold text-xs shadow-md transition-colors">Simpan Perubahan</button>
      </div>
    </form>
  </div>
</div>

<script>
  // Add Modal
  function openAddModal() {
    document.getElementById('addModal').classList.remove('hidden');
    document.getElementById('addModal').classList.add('flex');
  }
  function closeAddModal() {
    document.getElementById('addModal').classList.add('hidden');
    document.getElementById('addModal').classList.remove('flex');
  }

  // Restock Modal
  function openRestockModal(med) {
    document.getElementById('restockForm').action = `/admin/medicines/${med.id}/restock`;
    document.getElementById('restock-med-name').innerText = `${med.namaObat} (Stok Saat Ini: ${med.stok} ${med.satuan})`;
    document.getElementById('restock-satuan').innerText = med.satuan;
    document.getElementById('restockModal').classList.remove('hidden');
    document.getElementById('restockModal').classList.add('flex');
  }
  function closeRestockModal() {
    document.getElementById('restockModal').classList.add('hidden');
    document.getElementById('restockModal').classList.remove('flex');
  }

  // Edit Modal
  function openEditModal(med) {
    document.getElementById('editForm').action = `/admin/medicines/${med.id}/edit`;
    document.getElementById('edit-nama').value = med.namaObat;
    document.getElementById('edit-kategori').value = med.kategori;
    document.getElementById('edit-satuan').value = med.satuan;
    document.getElementById('edit-stok').value = med.stok;
    document.getElementById('edit-minStok').value = med.minStok;
    document.getElementById('edit-lokasiRak').value = med.lokasiRak || '';
    document.getElementById('edit-aturanPakai').value = med.aturanPakai || '';

    if (med.tglKadaluarsa) {
      const d = new Date(med.tglKadaluarsa);
      document.getElementById('edit-tglKadaluarsa').value = d.toISOString().split('T')[0];
    }

    document.getElementById('editModal').classList.remove('hidden');
    document.getElementById('editModal').classList.add('flex');
  }
  function closeEditModal() {
    document.getElementById('editModal').classList.add('hidden');
    document.getElementById('editModal').classList.remove('flex');
  }
</script>
