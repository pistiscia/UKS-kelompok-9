<%- include('../partials/header') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/navbar') %>

    <main class="flex-1 p-6 md:p-8 space-y-6 max-w-7xl w-full mx-auto">
      
      <!-- Top Action Bar (No-print) -->
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 no-print">
        <div>
          <span class="inline-flex items-center space-x-1 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 text-teal-800">
            <i class="fa-solid fa-file-invoice text-[10px]"></i>
            <span>Arsip & Laporan Bulanan</span>
          </span>
          <h1 class="text-2xl font-extrabold text-slate-900 mt-2">
            Rekapitulasi Kunjungan UKS Bulanan
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Laporan resmi kegiatan layanan kesehatan siswa untuk Pembina UKS dan Kepala Sekolah.
          </p>
        </div>

        <div class="flex items-center space-x-3">
          <button
            type="button"
            onclick="window.print()"
            class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-md shadow-brand-600/30 transition-all flex items-center space-x-2"
          >
            <i class="fa-solid fa-print"></i>
            <span>Cetak Dokumen Laporan</span>
          </button>
        </div>
      </div>

      <!-- Filter Form (No-print) -->
      <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm no-print">
        <form action="/petugas/laporan-bulanan" method="GET" class="flex flex-wrap items-center gap-4">
          <div class="flex items-center space-x-2">
            <label class="text-xs font-bold text-slate-700 uppercase">Bulan:</label>
            <select name="bulan" class="px-3 py-2 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-teal-500">
              <% const namaBulanArr = ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember']; %>
              <% for (let i = 1; i <= 12; i++) { %>
                <option value="<%= i %>" <%= selectedBulan === i ? 'selected' : '' %>>
                  <%= namaBulanArr[i - 1] %>
                </option>
              <% } %>
            </select>
          </div>

          <div class="flex items-center space-x-2">
            <label class="text-xs font-bold text-slate-700 uppercase">Tahun:</label>
            <select name="tahun" class="px-3 py-2 border border-slate-200 rounded-xl text-xs font-semibold text-slate-800 focus:ring-2 focus:ring-teal-500">
              <option value="2025" <%= selectedTahun === 2025 ? 'selected' : '' %>>2025</option>
              <option value="2026" <%= selectedTahun === 2026 ? 'selected' : '' %>>2026</option>
              <option value="2027" <%= selectedTahun === 2027 ? 'selected' : '' %>>2027</option>
            </select>
          </div>

          <button type="submit" class="px-5 py-2 rounded-xl bg-slate-800 text-white font-bold text-xs hover:bg-slate-900 transition-colors">
            Tampilkan Data
          </button>
        </form>
      </div>

      <!-- ================= DOKUMEN CETAK RESMI ================= -->
      <div class="bg-white p-6 sm:p-10 rounded-2xl border border-slate-200/80 shadow-sm print:border-none print:shadow-none print:p-0 print-container">
        
        <!-- KOP LAPORAN RESMI (Hanya muncul rapi di cetak atau preview) -->
        <div class="flex items-center justify-between pb-4 border-b-2 border-slate-800 mb-6">
          <div class="w-14 h-14 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-xl flex-shrink-0">
            <i class="fa-solid fa-hospital-user"></i>
          </div>
          <div class="text-center flex-1 px-4">
            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-600">PEMERINTAH DAERAH PROVINSI DKI JAKARTA</h4>
            <h3 class="text-xs font-bold uppercase tracking-wider text-slate-800">DINAS PENDIDIKAN & KEBUDAYAAN</h3>
            <h1 class="text-lg md:text-xl font-black uppercase text-slate-900">
              LAPORAN REKAPITULASI KUNJUNGAN PASIEN UKS
            </h1>
            <p class="text-xs font-semibold text-brand-700 mt-0.5">
              Periode: <%= namaBulan %> <%= selectedTahun %>
            </p>
          </div>
          <div class="text-right text-[10px] text-slate-500">
            <div>Dokumen Resmi UKS</div>
            <div class="font-mono mt-1">Dicetak: <%= new Date().toLocaleDateString('id-ID') %></div>
          </div>
        </div>

        <!-- KPI Ringkasan Bulan Tersebut -->
        <div class="grid grid-cols-2 sm:grid-cols-5 gap-3 mb-6">
          <div class="p-3 rounded-xl bg-slate-50 border border-slate-200 text-center">
            <span class="text-[10px] uppercase font-bold text-slate-400">Total Kunjungan</span>
            <div class="text-xl font-extrabold text-slate-900 mt-0.5"><%= stats.total %></div>
            <span class="text-[10px] text-slate-500">Siswa Masuk</span>
          </div>
          <div class="p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-center">
            <span class="text-[10px] uppercase font-bold text-emerald-700">Kembali Kelas</span>
            <div class="text-xl font-extrabold text-emerald-800 mt-0.5"><%= stats.kembaliKelas %></div>
            <span class="text-[10px] text-emerald-600">Sembuh/Membaik</span>
          </div>
          <div class="p-3 rounded-xl bg-amber-50 border border-amber-200 text-center">
            <span class="text-[10px] uppercase font-bold text-amber-700">Rawat Bed UKS</span>
            <div class="text-xl font-extrabold text-amber-800 mt-0.5"><%= stats.dirawat %></div>
            <span class="text-[10px] text-amber-600">Observasi</span>
          </div>
          <div class="p-3 rounded-xl bg-rose-50 border border-rose-200 text-center">
            <span class="text-[10px] uppercase font-bold text-rose-700">Izin Pulang</span>
            <div class="text-xl font-extrabold text-rose-800 mt-0.5"><%= stats.pulang %></div>
            <span class="text-[10px] text-rose-600">Dijemput Ortu</span>
          </div>
          <div class="p-3 rounded-xl bg-purple-50 border border-purple-200 text-center">
            <span class="text-[10px] uppercase font-bold text-purple-700">Rujuk Puskesmas</span>
            <div class="text-xl font-extrabold text-purple-800 mt-0.5"><%= stats.dirujuk %></div>
            <span class="text-[10px] text-purple-600">Faskes Luar</span>
          </div>
        </div>

        <!-- TABEL RINCIAN KUNJUNGAN SISWA -->
        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs border border-slate-300">
            <thead class="bg-slate-100 text-slate-700 uppercase font-bold tracking-wider border-b border-slate-300">
              <tr>
                <th class="px-3 py-2.5 border-r border-slate-300 text-center w-10">No</th>
                <th class="px-3 py-2.5 border-r border-slate-300">Tanggal & Jam</th>
                <th class="px-3 py-2.5 border-r border-slate-300">Identitas Siswa</th>
                <th class="px-3 py-2.5 border-r border-slate-300">Keluhan & Suhu</th>
                <th class="px-3 py-2.5 border-r border-slate-300">Tindakan Medis</th>
                <th class="px-3 py-2.5 border-r border-slate-300">Obat (P3K)</th>
                <th class="px-3 py-2.5 text-center">Status</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% if (records && records.length > 0) { %>
                <% records.forEach((rec, idx) => { %>
                  <tr class="hover:bg-slate-50">
                    <td class="px-3 py-2.5 text-center font-bold border-r border-slate-200"><%= idx + 1 %></td>
                    <td class="px-3 py-2.5 border-r border-slate-200 whitespace-nowrap">
                      <div class="font-semibold"><%= new Date(rec.tglKunjungan).toLocaleDateString('id-ID', { day: 'numeric', month: 'short' }) %></div>
                      <div class="text-[10px] text-slate-500 font-mono"><%= rec.jamMasuk %> WIB</div>
                    </td>
                    <td class="px-3 py-2.5 border-r border-slate-200">
                      <div class="font-bold text-slate-900"><%= rec.student.nama %></div>
                      <div class="text-[10px] text-slate-500"><%= rec.student.kelas || '-' %> • NISN: <%= rec.student.nisn || '-' %></div>
                    </td>
                    <td class="px-3 py-2.5 border-r border-slate-200">
                      <div class="font-medium text-slate-800"><%= rec.keluhan %></div>
                      <div class="text-[10px] font-semibold text-rose-600 mt-0.5">
                        Suhu: <%= rec.suhuTubuh %>°C | Tensi: <%= rec.tensi || '-' %>
                      </div>
                    </td>
                    <td class="px-3 py-2.5 border-r border-slate-200">
                      <div class="text-slate-700"><%= rec.tindakan %></div>
                    </td>
                    <td class="px-3 py-2.5 border-r border-slate-200">
                      <% if (rec.prescriptions && rec.prescriptions.length > 0) { %>
                        <% rec.prescriptions.forEach(p => { %>
                          <div class="text-[11px] font-medium text-teal-800">
                            • <%= p.medicine.namaObat %> (<%= p.jumlah %> <%= p.medicine.satuan %>)
                          </div>
                        <% }) %>
                      <% } else { %>
                        <span class="text-slate-400 italic text-[11px]">-</span>
                      <% } %>
                    </td>
                    <td class="px-3 py-2.5 text-center whitespace-nowrap">
                      <% if (rec.status === 'KEMBALI_KELAS') { %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          Kembali Kelas
                        </span>
                      <% } else if (rec.status === 'DIRAWAT') { %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-100 text-amber-800">
                          Dirawat
                        </span>
                      <% } else if (rec.status === 'PULANG') { %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-100 text-rose-800">
                          Izin Pulang
                        </span>
                      <% } else if (rec.status === 'DIRUJUK') { %>
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-purple-100 text-purple-800">
                          Dirujuk
                        </span>
                      <% } %>
                      <% if (rec.noSurat) { %>
                        <div class="text-[9px] font-mono text-purple-700 mt-0.5"><%= rec.noSurat %></div>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-5 py-8 text-center text-slate-400">
                    Tidak ada catatan kunjungan rekam medis untuk periode <%= namaBulan %> <%= selectedTahun %>.
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>

        <!-- TANDA TANGAN DOKUMEN LAPORAN RESMI -->
        <div class="mt-12 pt-6 border-t border-slate-300 grid grid-cols-2 gap-8 text-center text-xs text-slate-800">
          <div class="flex flex-col justify-between h-36">
            <div>
              Mengetahui,<br>
              <strong>Kepala Sekolah</strong>
            </div>
            <div>
              <div class="font-bold underline text-slate-900">Dr. H. Bambang Sudarsono, M.Pd</div>
              <div class="text-[10px] text-slate-500">NIP. 19690312 199403 1 003</div>
            </div>
          </div>

          <div class="flex flex-col justify-between h-36">
            <div>
              Jakarta, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %><br>
              <strong>Pembina & Penanggung Jawab UKS</strong>
            </div>
            <div>
              <div class="font-bold underline text-slate-900"><%= pembina.nama %></div>
              <div class="text-[10px] text-slate-500">NIP. 19780415 200212 2 001</div>
            </div>
          </div>
        </div>

      </div>

    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
