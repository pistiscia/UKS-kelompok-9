<%- include('../partials/header') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/navbar') %>

    <main class="flex-1 p-6 md:p-8 space-y-6 max-w-5xl w-full mx-auto">
      
      <!-- Page Header -->
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-3">
          <a href="/petugas/dashboard" class="p-2.5 rounded-xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-50 transition-colors">
            <i class="fa-solid fa-arrow-left"></i>
          </a>
          <div>
            <h1 class="text-2xl font-extrabold text-slate-900">Registrasi Pemeriksaan Siswa</h1>
            <p class="text-xs text-slate-500 mt-0.5">Catat tanda vital, diagnosa keluhan, dan input pemberian obat P3K</p>
          </div>
        </div>
      </div>

      <%- include('../partials/alerts') %>

      <!-- Main Form -->
      <form action="/petugas/kunjungan/baru" method="POST" id="visitForm" class="space-y-6">
        
        <!-- CARD 1: Identitas Pasien Siswa & Deteksi Alergi -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center space-x-2.5 pb-3 border-b border-slate-100">
            <div class="w-7 h-7 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-xs">
              1
            </div>
            <h3 class="text-sm font-bold text-slate-900">Identitas Siswa (Pasien)</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label for="studentSelect" class="block text-xs font-bold text-slate-700 uppercase">Pilih Siswa Terdaftar *</label>
              <select
                id="studentSelect"
                name="studentId"
                required
                onchange="handleStudentChange()"
                class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none bg-slate-50 font-medium"
              >
                <option value="">-- Cari & Pilih Nama Siswa --</option>
                <% students.forEach(s => { %>
                  <option
                    value="<%= s.id %>"
                    data-nisn="<%= s.nisn || '-' %>"
                    data-kelas="<%= s.kelas || '-' %>"
                    data-goldar="<%= s.golonganDarah || '?' %>"
                    data-ortu="<%= s.teleponOrtu || '-' %>"
                    data-penyakit="<%= s.healthProfile ? s.healthProfile.riwayatPenyakit : '' %>"
                    data-alergi-obat="<%= s.healthProfile ? s.healthProfile.alergiObat : '' %>"
                    data-alergi-makanan="<%= s.healthProfile ? s.healthProfile.alergiMakanan : '' %>"
                    data-darurat="<%= s.healthProfile ? s.healthProfile.kontakDarurat : '' %>"
                  >
                    <%= s.nama %> (<%= s.kelas || 'Siswa' %> - NISN: <%= s.nisn || '-' %>)
                  </option>
                <% }) %>
              </select>
            </div>

            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase">Jam Masuk UKS *</label>
                <input
                  type="text"
                  name="jamMasuk"
                  value="<%= currentClock %>"
                  required
                  placeholder="08:30"
                  class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs font-mono font-bold text-slate-800 focus:ring-2 focus:ring-teal-500 focus:outline-none"
                />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase">Jam Keluar (Opsional)</label>
                <input
                  type="text"
                  name="jamKeluar"
                  placeholder="09:30 (jika selesai)"
                  class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs font-mono text-slate-800 focus:ring-2 focus:ring-teal-500 focus:outline-none"
                />
              </div>
            </div>
          </div>

          <!-- Live Student Health Preview & Allergy Warning Box -->
          <div id="student-alert-box" class="hidden p-4 rounded-xl border transition-all">
            <!-- Isi di-generate via JavaScript -->
          </div>
        </div>

        <!-- CARD 2: Tanda Vital & Pemeriksaan Medis Fisik -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center space-x-2.5 pb-3 border-b border-slate-100">
            <div class="w-7 h-7 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-xs">
              2
            </div>
            <h3 class="text-sm font-bold text-slate-900">Pemeriksaan Fisik & Tanda Vital</h3>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Suhu Tubuh -->
            <div>
              <div class="flex items-center justify-between">
                <label class="block text-xs font-bold text-slate-700 uppercase">Suhu Tubuh (°C) *</label>
                <span id="fever-indicator" class="hidden text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-100 text-rose-700">
                  ⚠️ DEMAM TINGGI
                </span>
              </div>
              <div class="mt-1 relative rounded-xl shadow-sm">
                <input
                  type="number"
                  step="0.1"
                  min="34"
                  max="43"
                  id="suhuTubuhInput"
                  name="suhuTubuh"
                  value="38.5"
                  required
                  oninput="checkFever(this.value)"
                  placeholder="Contoh: 38.5"
                  class="w-full pl-3.5 pr-12 py-2.5 border border-slate-200 rounded-xl text-xs font-bold focus:ring-2 focus:ring-teal-500 focus:outline-none"
                />
                <span class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-xs font-bold text-slate-400">°C</span>
              </div>
              <p class="text-[10px] text-slate-400 mt-1">Normal: 36.5°C - 37.2°C | Demam: ≥ 37.5°C</p>
            </div>

            <!-- Tensi Darah -->
            <div>
              <label class="block text-xs font-bold text-slate-700 uppercase">Tensi Darah (mmHg)</label>
              <input
                type="text"
                name="tensi"
                value="120/80"
                placeholder="Contoh: 120/80"
                class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none"
              />
              <p class="text-[10px] text-slate-400 mt-1">Tekanan sistolik / diastolik (Opsional jika alat tersedia)</p>
            </div>
          </div>

          <!-- Keluhan -->
          <div>
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold text-slate-700 uppercase">Keluhan Gejala Siswa *</label>
              <div class="space-x-1 hidden sm:block">
                <button type="button" onclick="appendComplaint('Demam tinggi')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Demam</button>
                <button type="button" onclick="appendComplaint('Pusing sakit kepala')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Pusing</button>
                <button type="button" onclick="appendComplaint('Nyeri ulu hati / lambung perih')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Maag</button>
                <button type="button" onclick="appendComplaint('Luka lecet jatuh')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Luka</button>
              </div>
            </div>
            <textarea
              id="keluhanInput"
              name="keluhan"
              rows="2"
              required
              placeholder="Contoh: Siswa mengalami demam, suhu tubuh panas, pusing berputar, dan badan lemas..."
              class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none"
            >Demam dan pusing sakit kepala, badan meriang</textarea>
          </div>

          <!-- Tindakan Medis -->
          <div>
            <div class="flex items-center justify-between">
              <label class="block text-xs font-bold text-slate-700 uppercase">Tindakan Pertolongan Pertama *</label>
              <div class="space-x-1 hidden sm:block">
                <button type="button" onclick="appendAction('Istirahat berbaring di bed UKS')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Bed UKS</button>
                <button type="button" onclick="appendAction('Kompres air hangat dahi')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Kompres</button>
                <button type="button" onclick="appendAction('Diberikan air minum hangat')" class="px-2 py-0.5 rounded bg-slate-100 hover:bg-slate-200 text-[10px] text-slate-600 font-medium">+ Air Hangat</button>
              </div>
            </div>
            <textarea
              id="tindakanInput"
              name="tindakan"
              rows="2"
              required
              placeholder="Contoh: Diberikan istirahat di bed UKS, kompres air hangat pada dahi, observasi suhu secara berkala..."
              class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none"
            >Istirahat di ruang ber-AC tempat tidur UKS, kompres dahi, dan observasi tanda vital</textarea>
          </div>
        </div>

        <!-- CARD 3: Pemberian Obat P3K (Stok Otomatis Terpotong) -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center justify-between pb-3 border-b border-slate-100">
            <div class="flex items-center space-x-2.5">
              <div class="w-7 h-7 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-xs">
                3
              </div>
              <div>
                <h3 class="text-sm font-bold text-slate-900">Pemberian Obat-Obatan & Alat P3K</h3>
                <p class="text-[11px] text-slate-500">Stok obat akan otomatis berkurang dari inventaris secara atomik</p>
              </div>
            </div>

            <button
              type="button"
              onclick="addMedicineRow()"
              class="inline-flex items-center space-x-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-teal-50 text-teal-700 hover:bg-teal-100 transition-colors"
            >
              <i class="fa-solid fa-plus"></i>
              <span>Tambah Obat Lain</span>
            </button>
          </div>

          <!-- Container Baris Obat -->
          <div id="medicine-rows-container" class="space-y-3">
            <!-- Row 1 Default -->
            <div class="medicine-row p-3.5 rounded-xl border border-slate-200 bg-slate-50/60 grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
              <div class="md:col-span-5">
                <label class="block text-[11px] font-bold text-slate-700 uppercase">Pilih Obat Dari Rak</label>
                <select name="medicineIds" class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 bg-white">
                  <option value="">-- Tanpa Pemberian Obat --</option>
                  <% availableMedicines.forEach(med => { %>
                    <option value="<%= med.id %>" <%= med.namaObat.includes('Paracetamol 500mg') ? 'selected' : '' %>>
                      <%= med.namaObat %> (Sisa: <%= med.stok %> <%= med.satuan %>) - <%= med.lokasiRak || 'UKS' %>
                    </option>
                  <% }) %>
                </select>
              </div>

              <div class="md:col-span-2">
                <label class="block text-[11px] font-bold text-slate-700 uppercase">Jumlah</label>
                <input
                  type="number"
                  name="jumlahs"
                  min="1"
                  value="1"
                  class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-bold text-center focus:ring-2 focus:ring-teal-500 bg-white"
                />
              </div>

              <div class="md:col-span-4">
                <label class="block text-[11px] font-bold text-slate-700 uppercase">Aturan Pakai / Dosis</label>
                <input
                  type="text"
                  name="dosiss"
                  value="1 tablet sesudah makan"
                  placeholder="Contoh: 1 tablet sesudah makan"
                  class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 bg-white"
                />
              </div>

              <div class="md:col-span-1 text-right">
                <button
                  type="button"
                  onclick="removeMedicineRow(this)"
                  title="Hapus baris obat"
                  class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors"
                >
                  <i class="fa-solid fa-trash-can text-sm"></i>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- CARD 4: Status Keputusan Medis & Surat Izin / Rujukan -->
        <div class="bg-white p-6 rounded-2xl border border-slate-200/80 shadow-sm space-y-4">
          <div class="flex items-center space-x-2.5 pb-3 border-b border-slate-100">
            <div class="w-7 h-7 rounded-lg bg-teal-100 text-teal-700 flex items-center justify-center font-bold text-xs">
              4
            </div>
            <h3 class="text-sm font-bold text-slate-900">Keputusan Medis & Status Akhir</h3>
          </div>

          <div>
            <label class="block text-xs font-bold text-slate-700 uppercase mb-2">Pilih Status Penanganan Siswa *</label>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
              <!-- Option 1: DIRAWAT -->
              <label class="flex flex-col p-3 rounded-xl border border-amber-200 bg-amber-50/40 cursor-pointer hover:bg-amber-100/60 transition-all">
                <div class="flex items-center space-x-2">
                  <input type="radio" name="status" value="DIRAWAT" onchange="handleStatusChange(this.value)" class="text-amber-600 focus:ring-amber-500" />
                  <span class="text-xs font-bold text-amber-900">DIRAWAT</span>
                </div>
                <span class="text-[10px] text-amber-700 mt-1">Istirahat sementara di bed UKS</span>
              </label>

              <!-- Option 2: KEMBALI_KELAS -->
              <label class="flex flex-col p-3 rounded-xl border border-emerald-200 bg-emerald-50/40 cursor-pointer hover:bg-emerald-100/60 transition-all">
                <div class="flex items-center space-x-2">
                  <input type="radio" name="status" value="KEMBALI_KELAS" onchange="handleStatusChange(this.value)" class="text-emerald-600 focus:ring-emerald-500" />
                  <span class="text-xs font-bold text-emerald-900">KEMBALI KELAS</span>
                </div>
                <span class="text-[10px] text-emerald-700 mt-1">Kondisi membaik untuk belajar</span>
              </label>

              <!-- Option 3: PULANG -->
              <label class="flex flex-col p-3 rounded-xl border border-rose-200 bg-rose-50/40 cursor-pointer hover:bg-rose-100/60 transition-all">
                <div class="flex items-center space-x-2">
                  <input type="radio" name="status" value="PULANG" checked onchange="handleStatusChange(this.value)" class="text-rose-600 focus:ring-rose-500" />
                  <span class="text-xs font-bold text-rose-900">IZIN PULANG</span>
                </div>
                <span class="text-[10px] text-rose-700 mt-1">Tidak mampu belajar, dijemput ortu</span>
              </label>

              <!-- Option 4: DIRUJUK -->
              <label class="flex flex-col p-3 rounded-xl border border-purple-200 bg-purple-50/40 cursor-pointer hover:bg-purple-100/60 transition-all">
                <div class="flex items-center space-x-2">
                  <input type="radio" name="status" value="DIRUJUK" onchange="handleStatusChange(this.value)" class="text-purple-600 focus:ring-purple-500" />
                  <span class="text-xs font-bold text-purple-900">DIRUJUK</span>
                </div>
                <span class="text-[10px] text-purple-700 mt-1">Rujukan darurat ke Puskesmas/RS</span>
              </label>
            </div>
          </div>

          <!-- Section Terbitkan Surat Resmi -->
          <div id="surat-section" class="pt-4 border-t border-slate-100 space-y-4">
            <div class="flex items-center space-x-2.5">
              <input
                type="checkbox"
                id="buatSuratCheckbox"
                name="buatSurat"
                checked
                class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 border-slate-300"
              />
              <label for="buatSuratCheckbox" class="text-xs font-bold text-slate-800 cursor-pointer">
                <i class="fa-solid fa-file-contract text-brand-600 mr-1"></i> Terbitkan Surat Izin Istirahat / Rujukan Pulang Resmi Digital
              </label>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase">Fasilitas Kesehatan Rujukan (Jika Dirujuk)</label>
                <input
                  type="text"
                  name="faskesRujukan"
                  value="Puskesmas Kecamatan Setempat"
                  placeholder="Contoh: Puskesmas Kebon Jeruk / RSUD"
                  class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-slate-700 uppercase">Catatan / Alasan Untuk Surat Izin</label>
                <input
                  type="text"
                  name="keteranganSurat"
                  value="Kondisi siswa demam tinggi dan lemas sehingga tidak memungkinkan mengikuti kegiatan belajar mengajar di kelas."
                  placeholder="Keterangan untuk wali murid dan guru piket"
                  class="mt-1 w-full px-3.5 py-2.5 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 focus:outline-none"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Submit Bar -->
        <div class="flex flex-col sm:flex-row items-center justify-end gap-3 pt-2">
          <a href="/petugas/dashboard" class="w-full sm:w-auto px-6 py-3 rounded-xl border border-slate-200 bg-white hover:bg-slate-50 text-slate-700 font-semibold text-xs text-center transition-colors">
            Batalkan
          </a>
          <button
            type="submit"
            class="w-full sm:w-auto px-8 py-3 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-lg shadow-brand-600/30 transition-all flex items-center justify-center space-x-2"
          >
            <i class="fa-solid fa-floppy-disk"></i>
            <span>Simpan Kunjungan & Potong Stok Obat</span>
          </button>
        </div>

      </form>

    </main>

    <%- include('../partials/footer') %>
  </div>
</div>

<!-- JavaScript Logika Form -->
<script>
  // 1. Live student selection details and allergy alerts
  function handleStudentChange() {
    const select = document.getElementById('studentSelect');
    const selectedOption = select.options[select.selectedIndex];
    const alertBox = document.getElementById('student-alert-box');

    if (!selectedOption.value) {
      alertBox.classList.add('hidden');
      return;
    }

    const nisn = selectedOption.dataset.nisn;
    const kelas = selectedOption.dataset.kelas;
    const goldar = selectedOption.dataset.goldar;
    const penyakit = selectedOption.dataset.penyakit;
    const alergiObat = selectedOption.dataset.alergiObat;
    const alergiMakanan = selectedOption.dataset.alergiMakanan;
    const kontakDarurat = selectedOption.dataset.darurat;

    alertBox.classList.remove('hidden');

    let html = `
      <div class="flex flex-col sm:flex-row items-start justify-between gap-3">
        <div>
          <div class="flex items-center space-x-2">
            <span class="font-bold text-slate-900 text-xs">${selectedOption.text.split('(')[0]}</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-100 text-slate-700">Kelas: ${kelas}</span>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-50 text-red-700 border border-red-200">Gol: ${goldar}</span>
          </div>
          <div class="text-[11px] text-slate-500 mt-1">
            <strong>Riwayat Penyakit:</strong> ${penyakit || '<span class="italic text-slate-400">Tidak ada</span>'}
          </div>
        </div>
        <div class="text-[11px] text-slate-600 sm:text-right">
          <div><strong>Kontak Darurat:</strong> ${kontakDarurat || '-'}</div>
        </div>
      </div>
    `;

    // Warning Banner jika ada Alergi Obat
    if (alergiObat && alergiObat.trim().length > 0) {
      alertBox.className = 'p-4 rounded-xl border border-rose-300 bg-rose-50 text-rose-900 transition-all';
      html += `
        <div class="mt-3 pt-3 border-t border-rose-200 flex items-center space-x-2 text-xs font-bold text-rose-700 animate-pulse">
          <i class="fa-solid fa-triangle-exclamation text-base"></i>
          <span>PERINGATAN REKAM MEDIS: Siswa memiliki ALERGI OBAT: "${alergiObat}". Hati-hati dalam memilih resep obat!</span>
        </div>
      `;
    } else {
      alertBox.className = 'p-4 rounded-xl border border-emerald-200 bg-emerald-50/50 text-slate-800 transition-all';
    }

    alertBox.innerHTML = html;
  }

  // 2. Deteksi demam suhu tubuh
  function checkFever(temp) {
    const feverBadge = document.getElementById('fever-indicator');
    const val = parseFloat(temp);
    if (!isNaN(val) && val >= 37.5) {
      feverBadge.classList.remove('hidden');
    } else {
      feverBadge.classList.add('hidden');
    }
  }

  // 3. Status change handler
  function handleStatusChange(val) {
    const checkbox = document.getElementById('buatSuratCheckbox');
    if (val === 'PULANG' || val === 'DIRUJUK') {
      checkbox.checked = true;
    }
  }

  // 4. Quick text buttons
  function appendComplaint(text) {
    const el = document.getElementById('keluhanInput');
    el.value = el.value ? `${el.value}, ${text}` : text;
  }
  function appendAction(text) {
    const el = document.getElementById('tindakanInput');
    el.value = el.value ? `${el.value}, ${text}` : text;
  }

  // 5. Dynamic medicine prescription rows
  function addMedicineRow() {
    const container = document.getElementById('medicine-rows-container');
    const template = `
      <div class="medicine-row p-3.5 rounded-xl border border-slate-200 bg-slate-50/60 grid grid-cols-1 md:grid-cols-12 gap-3 items-end">
        <div class="md:col-span-5">
          <label class="block text-[11px] font-bold text-slate-700 uppercase">Pilih Obat Dari Rak</label>
          <select name="medicineIds" class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 bg-white">
            <option value="">-- Pilih Obat --</option>
            <% availableMedicines.forEach(med => { %>
              <option value="<%= med.id %>">
                <%= med.namaObat %> (Sisa: <%= med.stok %> <%= med.satuan %>) - <%= med.lokasiRak || 'UKS' %>
              </option>
            <% }) %>
          </select>
        </div>
        <div class="md:col-span-2">
          <label class="block text-[11px] font-bold text-slate-700 uppercase">Jumlah</label>
          <input type="number" name="jumlahs" min="1" value="1" class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-xl text-xs font-bold text-center focus:ring-2 focus:ring-teal-500 bg-white" />
        </div>
        <div class="md:col-span-4">
          <label class="block text-[11px] font-bold text-slate-700 uppercase">Aturan Pakai / Dosis</label>
          <input type="text" name="dosiss" value="1 tablet sesudah makan" class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-xl text-xs focus:ring-2 focus:ring-teal-500 bg-white" />
        </div>
        <div class="md:col-span-1 text-right">
          <button type="button" onclick="removeMedicineRow(this)" title="Hapus baris obat" class="p-2 text-rose-500 hover:text-rose-700 hover:bg-rose-50 rounded-lg transition-colors">
            <i class="fa-solid fa-trash-can text-sm"></i>
          </button>
        </div>
      </div>
    `;
    container.insertAdjacentHTML('beforeend', template);
  }

  function removeMedicineRow(btn) {
    const row = btn.closest('.medicine-row');
    const container = document.getElementById('medicine-rows-container');
    if (container.querySelectorAll('.medicine-row').length > 1) {
      row.remove();
    } else {
      // Kosongkan isian jika baris terakhir
      row.querySelector('select').value = '';
    }
  }

  // Trigger default check on load
  document.addEventListener('DOMContentLoaded', () => {
    checkFever(document.getElementById('suhuTubuhInput').value);
  });
</script>
