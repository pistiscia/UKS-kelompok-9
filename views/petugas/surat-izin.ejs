<%- include('../partials/header') %>

<div class="min-h-screen bg-slate-100 py-6 px-4 sm:px-6 lg:px-8 print:p-0 print:bg-white">
  
  <!-- Action Buttons (No-print) -->
  <div class="max-w-3xl mx-auto mb-6 flex items-center justify-between no-print">
    <div class="flex items-center space-x-2">
      <a href="/petugas/dashboard" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-sm">
        <i class="fa-solid fa-arrow-left mr-1"></i> Kembali ke Dashboard
      </a>
      <a href="/petugas/kunjungan/<%= record.id %>" class="px-4 py-2 rounded-xl bg-white border border-slate-200 text-xs font-semibold text-slate-700 hover:bg-slate-50 transition-colors shadow-sm">
        Lihat Rekam Medis
      </a>
    </div>

    <button
      type="button"
      onclick="window.print()"
      class="px-5 py-2.5 rounded-xl bg-brand-600 hover:bg-brand-700 text-white font-bold text-xs shadow-lg shadow-brand-600/30 transition-all flex items-center space-x-2"
    >
      <i class="fa-solid fa-print"></i>
      <span>Cetak Surat Resmi (PDF/Print)</span>
    </button>
  </div>

  <!-- SURAT RESMI (PRINT CONTAINER) -->
  <div class="max-w-3xl mx-auto bg-white p-8 md:p-12 rounded-2xl shadow-xl border border-slate-200 print:shadow-none print:border-none print:p-0 print:m-0 print-container">
    
    <!-- KOP SURAT RESMI -->
    <div class="flex items-center justify-between pb-4 border-b-4 border-double border-slate-900 mb-6">
      <div class="w-16 h-16 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-2xl flex-shrink-0">
        <i class="fa-solid fa-hospital-user"></i>
      </div>
      <div class="text-center flex-1 px-4">
        <h3 class="text-xs font-bold uppercase tracking-widest text-slate-600">PEMERINTAH PROVINSI DAERAH KHUSUS IBUKOTA</h3>
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-700">DINAS PENDIDIKAN DAN KEBUDAYAAN</h4>
        <h1 class="text-lg md:text-xl font-extrabold uppercase tracking-tight text-slate-900 mt-0.5">
          UNIT USAHA KESEHATAN SEKOLAH (E-UKS)
        </h1>
        <p class="text-[11px] text-slate-600 mt-0.5">
          Jl. Pendidikan Sehat No. 10 Jakarta Barat • Telp: (021) 582-9900 • Email: uks@sekolah.sch.id
        </p>
      </div>
      <div class="w-16 h-16 border-2 border-slate-300 rounded-lg flex flex-col items-center justify-center p-1 text-center flex-shrink-0 bg-slate-50">
        <i class="fa-solid fa-qrcode text-2xl text-slate-700"></i>
        <span class="text-[8px] font-mono text-slate-500 mt-0.5">VERIFIED</span>
      </div>
    </div>

    <!-- JUDUL SURAT -->
    <div class="text-center my-6">
      <h2 class="text-base font-extrabold uppercase tracking-wide underline text-slate-900">
        <% if (record.status === 'DIRUJUK') { %>
          SURAT RUJUKAN FASILITAS KESEHATAN SEKOLAH
        <% } else { %>
          SURAT KETERANGAN SAKIT & IZIN ISTIRAHAT PULANG
        <% } %>
      </h2>
      <p class="font-mono text-xs font-bold text-slate-600 mt-1">
        Nomor: <%= record.noSurat || 'UKS/E-MED/' + new Date().getFullYear() + '/X/001' %>
      </p>
    </div>

    <!-- ISI SURAT -->
    <div class="space-y-4 text-xs text-slate-800 leading-relaxed">
      <p>
        Yang bertanda tangan di bawah ini, Tenaga Medis / Petugas Layanan Usaha Kesehatan Sekolah (UKS), menerangkan dengan sebenarnya bahwa:
      </p>

      <!-- Data Identitas Siswa -->
      <table class="w-full my-3 border border-slate-200">
        <tbody class="divide-y divide-slate-200">
          <tr class="bg-slate-50/50">
            <td class="px-4 py-2 font-bold text-slate-600 w-44">Nama Siswa</td>
            <td class="px-4 py-2 font-extrabold text-slate-900 text-sm"><%= record.student.nama %></td>
          </tr>
          <tr>
            <td class="px-4 py-2 font-bold text-slate-600">Nomor Induk Siswa (NISN)</td>
            <td class="px-4 py-2 font-mono"><%= record.student.nisn || '-' %></td>
          </tr>
          <tr class="bg-slate-50/50">
            <td class="px-4 py-2 font-bold text-slate-600">Kelas / Rombel</td>
            <td class="px-4 py-2 font-semibold"><%= record.student.kelas || '-' %></td>
          </tr>
          <tr>
            <td class="px-4 py-2 font-bold text-slate-600">Golongan Darah</td>
            <td class="px-4 py-2 font-bold text-red-600"><%= record.student.golonganDarah || '-' %></td>
          </tr>
          <tr class="bg-slate-50/50">
            <td class="px-4 py-2 font-bold text-slate-600">Waktu Pemeriksaan UKS</td>
            <td class="px-4 py-2 font-medium">
              <%= new Date(record.tglKunjungan).toLocaleDateString('id-ID', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %> (Pkl <%= record.jamMasuk %> WIB)
            </td>
          </tr>
        </tbody>
      </table>

      <!-- Hasil Pemeriksaan Medis -->
      <p class="font-bold text-slate-900 pt-2">
        Hasil Pemeriksaan Fisik & Indikasi Medis:
      </p>
      
      <div class="grid grid-cols-2 gap-3 p-3 bg-slate-50 rounded-xl border border-slate-200 font-mono text-[11px]">
        <div>
          <span class="text-slate-500">Suhu Tubuh:</span>
          <strong class="<%= record.suhuTubuh >= 37.5 ? 'text-rose-600' : 'text-slate-800' %>"><%= record.suhuTubuh %> °C</strong>
          <% if (record.suhuTubuh >= 37.5) { %>(Febris / Demam)<% } %>
        </div>
        <div>
          <span class="text-slate-500">Tekanan Darah:</span>
          <strong><%= record.tensi || '-' %> mmHg</strong>
        </div>
        <div class="col-span-2">
          <span class="text-slate-500">Keluhan Gejala:</span>
          <span class="font-sans font-semibold text-slate-800"><%= record.keluhan %></span>
        </div>
        <div class="col-span-2">
          <span class="text-slate-500">Pertolongan Pertama:</span>
          <span class="font-sans text-slate-700"><%= record.tindakan %></span>
        </div>
        <% if (record.prescriptions && record.prescriptions.length > 0) { %>
          <div class="col-span-2">
            <span class="text-slate-500">Obat Diberikan:</span>
            <span class="font-sans text-teal-800 font-medium">
              <% record.prescriptions.forEach(p => { %>
                <%= p.medicine.namaObat %> (<%= p.jumlah %> <%= p.medicine.satuan %> - <%= p.dosis %>);
              <% }) %>
            </span>
          </div>
        <% } %>
      </div>

      <!-- Keputusan & Rekomendasi -->
      <div class="p-4 bg-emerald-50/60 border border-emerald-200 rounded-xl text-xs space-y-1">
        <h4 class="font-bold text-emerald-950 uppercase">Rekomendasi Medis UKS:</h4>
        <p class="text-emerald-900">
          <% if (record.status === 'DIRUJUK') { %>
            Berdasarkan observasi kondisi siswa, kami menyarankan penanganan lanjutan ke <strong><%= record.faskesRujukan || 'Puskesmas / Rumah Sakit terdekat' %></strong> untuk pemeriksaan laboratorium dan diagnosa dokter spesialis lebih lanjut.
          <% } else { %>
            Mengingat kondisi fisik siswa yang mengalami keluhan sakit dan tidak memungkinkan untuk mengikuti kegiatan belajar mengajar secara optimal, maka kepada yang bersangkutan diberikan <strong>izin untuk beristirahat di rumah / dijemput oleh orang tua/wali</strong>.
          <% } %>
        </p>
        <% if (record.keteranganSurat) { %>
          <p class="text-slate-600 text-[11px] pt-1">
            <strong>Catatan Tambahan:</strong> <%= record.keteranganSurat %>
          </p>
        <% } %>
      </div>

      <p class="pt-2">
        Demikian surat keterangan ini diterbitkan dengan sebenarnya untuk diketahui oleh Guru Piket, Wali Kelas, dan Orang Tua/Wali Murid yang bersangkutan.
      </p>
    </div>

    <!-- TANDA TANGAN PIHAK TERKAIT -->
    <div class="mt-10 pt-6 border-t border-slate-200 grid grid-cols-3 gap-4 text-center text-xs text-slate-800">
      <!-- Kolom 1: Wali Murid -->
      <div class="flex flex-col justify-between h-32">
        <div>Mengetahui,<br><span class="text-slate-500">Orang Tua / Wali Murid</span></div>
        <div class="font-bold underline text-slate-900">( ............................................ )</div>
      </div>

      <!-- Kolom 2: Petugas UKS -->
      <div class="flex flex-col justify-between h-32">
        <div>Diperiksa Oleh,<br><span class="text-slate-500">Petugas Medis / PMR</span></div>
        <div>
          <div class="font-bold underline text-slate-900"><%= record.petugas.nama %></div>
          <div class="text-[10px] text-slate-400 font-mono">ID: PET-<%= record.petugas.id %></div>
        </div>
      </div>

      <!-- Kolom 3: Pembina UKS -->
      <div class="flex flex-col justify-between h-32">
        <div>Jakarta, <%= new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' }) %><br><span class="text-slate-500">Pembina UKS Sekolah</span></div>
        <div>
          <div class="font-bold underline text-slate-900"><%= pembina.nama %></div>
          <div class="text-[10px] text-slate-400">NIP. 19780415 200212 2 001</div>
        </div>
      </div>
    </div>

    <!-- Watermark / Footer Surat -->
    <div class="mt-8 pt-3 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400">
      <span>Sistem Rekam Medis E-UKS Terintegrasi • Dokumen Sah Elektronik</span>
      <span class="font-mono">Ref: <%= record.noSurat || record.id %></span>
    </div>

  </div>

</div>

<%- include('../partials/footer') %>
