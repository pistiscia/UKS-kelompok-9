<%- include('../partials/header') %>

<div class="flex min-h-screen">
  <%- include('../partials/sidebar') %>

  <div class="flex-1 flex flex-col min-w-0">
    <%- include('../partials/navbar') %>

    <main class="flex-1 p-6 md:p-8 space-y-8 max-w-7xl w-full mx-auto">
      
      <!-- Welcome Header -->
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
          <span class="inline-flex items-center space-x-1.5 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-teal-100 text-teal-800">
            <i class="fa-solid fa-heart-pulse text-[10px]"></i>
            <span>Ruang Pelayanan Medis UKS</span>
          </span>
          <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 mt-2">
            Dashboard Layanan & Pemeriksaan Siswa
          </h1>
          <p class="text-sm text-slate-500 mt-0.5">
            Kelola kedatangan siswa sakit, diagnosa keluhan fisik, pemberian obat P3K, dan penerbitan izin istirahat.
          </p>
        </div>

        <div class="flex items-center space-x-3">
          <a href="/petugas/kunjungan/baru" class="inline-flex items-center space-x-2 px-5 py-2.5 rounded-xl text-sm font-semibold text-white bg-brand-600 hover:bg-brand-700 shadow-md shadow-brand-600/30 transition-all">
            <i class="fa-solid fa-user-plus"></i>
            <span>Registrasi Kunjungan Baru</span>
          </a>
          <a href="/petugas/laporan-bulanan" class="inline-flex items-center space-x-2 px-4 py-2.5 rounded-xl text-sm font-semibold text-slate-700 bg-white hover:bg-slate-50 border border-slate-200 shadow-sm transition-all">
            <i class="fa-solid fa-print"></i>
            <span>Cetak Rekap</span>
          </a>
        </div>
      </div>

      <%- include('../partials/alerts') %>

      <!-- 3 Quick KPI Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        <!-- Card 1: Kunjungan Hari Ini -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Kunjungan Masuk Hari Ini</p>
            <h3 class="text-3xl font-extrabold text-slate-800 mt-1"><%= todayVisits %></h3>
            <p class="text-xs text-slate-500 mt-1">Siswa membutuhkan penanganan</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-stethoscope"></i>
          </div>
        </div>

        <!-- Card 2: Sedang Dirawat di Bed UKS -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Sedang Istirahat di Bed UKS</p>
            <h3 class="text-3xl font-extrabold <%= activeTreatmentCount > 0 ? 'text-amber-600 animate-pulse' : 'text-slate-800' %> mt-1"><%= activeTreatmentCount %></h3>
            <p class="text-xs text-slate-500 mt-1">Siswa dalam observasi ruang UKS</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-bed-pulse"></i>
          </div>
        </div>

        <!-- Card 3: Surat Izin/Rujukan -->
        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-sm flex items-center justify-between">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-slate-400">Surat Izin / Rujukan Diterbitkan</p>
            <h3 class="text-3xl font-extrabold text-purple-600 mt-1"><%= suratCount %></h3>
            <p class="text-xs text-slate-500 mt-1">Hari ini (Pulang / Faskes)</p>
          </div>
          <div class="w-12 h-12 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center text-xl">
            <i class="fa-solid fa-file-signature"></i>
          </div>
        </div>
      </div>

      <!-- Section: Siswa Sedang Dirawat / Aktif Beristirahat di UKS -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-5 bg-gradient-to-r from-amber-50/60 to-orange-50/40 border-b border-amber-100 flex items-center justify-between">
          <div class="flex items-center space-x-3">
            <div class="w-8 h-8 rounded-lg bg-amber-500 text-white flex items-center justify-center text-sm font-bold shadow-sm">
              <i class="fa-solid fa-bed-pulse"></i>
            </div>
            <div>
              <h3 class="text-sm font-bold text-slate-900">Pasien Aktif di Tempat Tidur UKS (Observasi Berjalan)</h3>
              <p class="text-xs text-slate-500">Siswa yang saat ini masih beristirahat di ruang UKS</p>
            </div>
          </div>
          <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800">
            <%= activeTreatments.length %> Siswa
          </span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
              <tr>
                <th class="px-5 py-3.5">Nama Siswa / Kelas</th>
                <th class="px-5 py-3.5">Jam Masuk</th>
                <th class="px-5 py-3.5">Keluhan Utama</th>
                <th class="px-5 py-3.5">Suhu & Tensi</th>
                <th class="px-5 py-3.5">Obat Diberikan</th>
                <th class="px-5 py-3.5">Alergi Terdaftar</th>
                <th class="px-5 py-3.5 text-right">Tindakan Lanjutan</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (activeTreatments && activeTreatments.length > 0) { %>
                <% activeTreatments.forEach(rec => { %>
                  <tr class="hover:bg-amber-50/30 transition-colors">
                    <td class="px-5 py-4">
                      <div class="font-bold text-slate-900 text-sm"><%= rec.student.nama %></div>
                      <div class="text-[11px] text-slate-500"><%= rec.student.kelas || 'Siswa' %> • NISN: <%= rec.student.nisn || '-' %></div>
                    </td>
                    <td class="px-5 py-4 whitespace-nowrap font-mono font-bold text-slate-700">
                      Pkl <%= rec.jamMasuk %> WIB
                    </td>
                    <td class="px-5 py-4 max-w-xs">
                      <div class="font-medium text-slate-800"><%= rec.keluhan %></div>
                    </td>
                    <td class="px-5 py-4 whitespace-nowrap">
                      <div class="font-bold <%= rec.suhuTubuh >= 37.5 ? 'text-rose-600' : 'text-slate-700' %>">
                        <i class="fa-solid fa-temperature-half mr-1"></i><%= rec.suhuTubuh %>°C
                      </div>
                      <div class="text-[10px] text-slate-400">Tensi: <%= rec.tensi || '-' %></div>
                    </td>
                    <td class="px-5 py-4">
                      <% if (rec.prescriptions && rec.prescriptions.length > 0) { %>
                        <% rec.prescriptions.forEach(p => { %>
                          <span class="inline-block bg-teal-50 text-teal-700 border border-teal-200 px-2 py-0.5 rounded text-[10px] font-medium mr-1 mb-1">
                            <%= p.medicine.namaObat %> (<%= p.jumlah %>)
                          </span>
                        <% }) %>
                      <% } else { %>
                        <span class="text-slate-400 italic text-[11px]">-</span>
                      <% } %>
                    </td>
                    <td class="px-5 py-4">
                      <% if (rec.student.healthProfile && rec.student.healthProfile.alergiObat) { %>
                        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">
                          ⚠️ <%= rec.student.healthProfile.alergiObat %>
                        </span>
                      <% } else { %>
                        <span class="text-slate-400 text-[10px]">Aman</span>
                      <% } %>
                    </td>
                    <td class="px-5 py-4 text-right whitespace-nowrap">
                      <a href="/petugas/kunjungan/<%= rec.id %>" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-[11px] shadow-sm transition-colors">
                        Selesaikan / Rujuk <i class="fa-solid fa-arrow-right ml-1"></i>
                      </a>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-5 py-8 text-center text-slate-400">
                    <i class="fa-solid fa-circle-check text-emerald-500 text-2xl mb-1"></i>
                    <p class="font-medium">Tidak ada siswa yang sedang beristirahat di tempat tidur UKS saat ini.</p>
                  </td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

      <!-- Section: Seluruh Kunjungan Rekam Medis Terbaru -->
      <div class="bg-white rounded-2xl border border-slate-200/80 shadow-sm overflow-hidden">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="text-base font-bold text-slate-900">Riwayat Kunjungan & Pemeriksaan Medis Terkini</h3>
            <p class="text-xs text-slate-500">Log lengkap rekam medis tindakan kesehatan siswa</p>
          </div>
          <a href="/petugas/laporan-bulanan" class="text-xs font-bold text-brand-600 hover:text-brand-700">
            Lihat Laporan Bulanan <i class="fa-solid fa-arrow-right ml-1"></i>
          </a>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-xs">
            <thead class="bg-slate-50 text-slate-500 uppercase tracking-wider font-semibold border-b border-slate-200">
              <tr>
                <th class="px-5 py-3.5">Tanggal & Jam</th>
                <th class="px-5 py-3.5">Siswa / Kelas</th>
                <th class="px-5 py-3.5">Keluhan & Suhu</th>
                <th class="px-5 py-3.5">Tindakan Medis</th>
                <th class="px-5 py-3.5">Pemberian Obat (P3K)</th>
                <th class="px-5 py-3.5 text-center">Status</th>
                <th class="px-5 py-3.5 text-right">Detail & Dokumen</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
              <% if (recentRecords && recentRecords.length > 0) { %>
                <% recentRecords.forEach(rec => { %>
                  <tr class="hover:bg-slate-50/70 transition-colors">
                    <td class="px-5 py-4 whitespace-nowrap text-slate-600">
                      <div class="font-bold text-slate-900">
                        <%= new Date(rec.tglKunjungan).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                      </div>
                      <div class="font-mono text-[11px] text-slate-400">
                        Masuk: <%= rec.jamMasuk %> <%= rec.jamKeluar ? `| Keluar: ${rec.jamKeluar}` : '' %>
                      </div>
                    </td>
                    <td class="px-5 py-4">
                      <div class="font-bold text-slate-900"><%= rec.student.nama %></div>
                      <div class="text-[11px] text-slate-500"><%= rec.student.kelas || '-' %></div>
                    </td>
                    <td class="px-5 py-4 max-w-xs">
                      <div class="font-medium text-slate-800"><%= rec.keluhan %></div>
                      <div class="text-[11px] font-semibold mt-0.5 <%= rec.suhuTubuh >= 37.5 ? 'text-rose-600' : 'text-emerald-600' %>">
                        <i class="fa-solid fa-temperature-half"></i> <%= rec.suhuTubuh %>°C | Tensi: <%= rec.tensi || '-' %>
                      </div>
                    </td>
                    <td class="px-5 py-4 text-slate-600 max-w-xs">
                      <div class="line-clamp-2"><%= rec.tindakan %></div>
                    </td>
                    <td class="px-5 py-4">
                      <% if (rec.prescriptions && rec.prescriptions.length > 0) { %>
                        <% rec.prescriptions.forEach(p => { %>
                          <span class="inline-block bg-teal-50 text-teal-700 border border-teal-200 px-2 py-0.5 rounded text-[10px] font-medium mr-1 mb-1">
                            <%= p.medicine.namaObat %> (<%= p.jumlah %> <%= p.medicine.satuan %>)
                          </span>
                        <% }) %>
                      <% } else { %>
                        <span class="text-slate-400 italic text-[11px]">-</span>
                      <% } %>
                    </td>
                    <td class="px-5 py-4 text-center whitespace-nowrap">
                      <% if (rec.status === 'KEMBALI_KELAS') { %>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-emerald-100 text-emerald-800">
                          Kembali Kelas
                        </span>
                      <% } else if (rec.status === 'DIRAWAT') { %>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                          Dirawat di UKS
                        </span>
                      <% } else if (rec.status === 'PULANG') { %>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">
                          Izin Pulang
                        </span>
                      <% } else if (rec.status === 'DIRUJUK') { %>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-bold bg-purple-100 text-purple-800">
                          Dirujuk Puskesmas
                        </span>
                      <% } %>
                    </td>
                    <td class="px-5 py-4 text-right whitespace-nowrap space-x-1.5">
                      <a href="/petugas/kunjungan/<%= rec.id %>" class="px-2.5 py-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-[11px] transition-colors">
                        Lihat
                      </a>
                      <% if (rec.noSurat) { %>
                        <a href="/petugas/kunjungan/<%= rec.id %>/surat" title="Cetak Surat Izin Resmi" class="px-2.5 py-1.5 rounded-lg bg-purple-50 hover:bg-purple-100 text-purple-700 font-semibold text-[11px] border border-purple-200 transition-colors">
                          <i class="fa-solid fa-print mr-1"></i> Surat
                        </a>
                      <% } %>
                    </td>
                  </tr>
                <% }) %>
              <% } else { %>
                <tr>
                  <td colspan="7" class="px-5 py-8 text-center text-slate-400">Belum ada kunjungan yang tercatat.</td>
                </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </main>

    <%- include('../partials/footer') %>
  </div>
</div>
