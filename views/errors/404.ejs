<%- include('../partials/header') %>

<div class="min-h-screen bg-slate-50 flex items-center justify-center p-6">
  <div class="max-w-md w-full bg-white rounded-3xl p-8 border border-slate-200/80 shadow-xl text-center">
    <div class="w-20 h-20 rounded-2xl bg-amber-50 text-amber-500 mx-auto flex items-center justify-center text-4xl mb-6 shadow-sm border border-amber-100">
      <i class="fa-solid fa-triangle-exclamation"></i>
    </div>
    
    <span class="inline-block px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-100 text-amber-800 mb-2">
      HTTP 404 Not Found
    </span>
    
    <h1 class="text-2xl font-extrabold text-slate-800"><%= typeof title !== 'undefined' ? title : 'Halaman Tidak Ditemukan' %></h1>
    <p class="mt-2 text-sm text-slate-600">
      <%= typeof message !== 'undefined' ? message : 'Halaman atau berkas yang Anda tuju tidak tersedia pada sistem E-UKS.' %>
    </p>

    <div class="mt-6 flex justify-center">
      <a href="/" class="py-2.5 px-6 rounded-xl text-sm font-semibold bg-brand-600 text-white hover:bg-brand-700 transition-colors shadow-sm shadow-brand-600/30">
        Kembali ke Dashboard Utama
      </a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
